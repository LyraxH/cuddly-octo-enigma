[
    {
        "position": "top",
        "mode": "dock",
        "gtk-layer-shell": "true",
        "modules-left": [
            "cpu",
            "memory",
            "network",
            "hyprland/workspaces"
        ],
        "modules-center": [
            "clock#date"
        ],
        "modules-right": [
            "backlight",
            "pulseaudio",
            "clock#time",
            "power-profiles-daemon",
            "battery"
        ],
        /***************************/
        /*  M O D U L E S  T O P   */
        /***************************/
        "cpu": {
            "format": "[ {usage}%]" // | LOAD: {load} |
        },
        "memory": {
            "format": "[ {percentage}%]" // SWAP: {swapPercentage}
        },
        "disk": {
            "format": "[{used} of {total}]"
        },
        "hyprland/workspaces": {
            "format": "[{}]"
        },
        "backlight": {
            "format": "[󰃞 {percent}%]"
        },
        "pulseaudio": {
            "format": "[{volume}%]",
            "format-muted": "[MUTED]" //"[ : {volume}% ]"
        },
        "clock#date": {
            "format": "[{:%d-%m-%Y}]"
        },
        "clock#time": {
            "format": "[{:%H:%M}]",
            "interval": 59
        },
        "battery": {
            "format": "[{capacity}%]", // {health} | {}
            "format-alt": "[{time}]",
            "states": {
                "critical": 15,
                "warning": 30
            }
        },
        "network": {
            "format-down": "[disconnected]",
            "format": "[{signalStrength}|{frequency} GHz]",
            "format-alt": "[ wlan0: {ipaddr} | {netmask} | {gwaddr} ]"
        },
        "power-profiles-daemon": {
            "format": "{icon}",
            "format-icons": {
                "performance": "[ 󰆷 ]",
                "balanced": "[  ]",
                "power-saver": "[ 󱤅 ]"
            }
        }
    }
]