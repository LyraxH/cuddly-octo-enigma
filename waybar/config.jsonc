[
    {
        "position": "top",
        "mode": "dock",
        "height": 36,
        "gtk-layer-shell": true,
        "modules-left": ["cpu", "memory", "network", "hyprland/workspaces"],
        "modules-center":["hyprland/window"],
        "modules-right": ["backlight", "pulseaudio", "clock#time", "clock#date", "power-profiles-daemon", "battery"],

        "cpu": {
            "format": "󰄛 {usage}%",
            "interval": 10
        },
        "memory": {
            "format": "󰐵 {percentage}%",
            "interval": 10
        },
        "hyprland/workspaces": {
            "format": "{icon}",
            "format-icons": {
                "active": "󰄛",
                "default": "󰄜"
            }
        },
        "hyprland/window": {
            "format": "{}"
        },
        "backlight": {
            "format": "󰃞 {percent}%"
        },
        "pulseaudio": {
            "format": "󰕾 {volume}%",
            "format-muted": "󰝟",
            "on-click": "pavucontrol"
        },
        "clock#date": {
            "format": "󰃭 {:%d-%m-%Y}"
        },
        "clock#time": {
            "format": "󱑎 {:%H:%M}",
            "interval": 60
        },
        "battery": {
            "format": "{icon} {capacity}%",
            "format-alt": "{time}",
            "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
            "states": { "critical": 15, "warning": 30 }
        },
        "network": {
            "format": "󰤨 {signalStrength}%",
            "format-alt": "󰤨 {ipaddr} | {frequency}GHz",
            "format-down": "󰤭 Down",
            "interval": 10
        },
        "power-profiles-daemon": {
            "format": "{icon}",
            "format-icons": {
                "performance": "󰓅",
                "balanced": "󰾅",
                "power-saver": "󰾆"
            }
        }
    }
]
